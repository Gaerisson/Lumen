{
  "name": "lumen-desktop",
  "version": "8.2.3",
  "description": "Multi-screen Windows web dashboard",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/unit/*.test.js\"",
    "smoke": "electron . --smoke-test",
    "build": "node scripts/build.cjs",
    "check": "node scripts/check-layout.cjs",
    "smoke:home": "electron . --home-screen-test",
    "smoke:regression": "electron . --regression-test",
    "smoke:performance": "electron . --performance-test",
    "agent": "node src/agent.cjs",
    "smoke:setup": "electron . --setup-test"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "rcedit": "5.0.2",
    "ws": "8.22.0"
  },
  "productName": "Lumen",
  "author": "Gaerisson",
  "license": "UNLICENSED",
  "homepage": "https://github.com/Gaerisson/Lumen",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gaerisson/Lumen.git"
  }
}
